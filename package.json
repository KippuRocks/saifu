{
  "name": "saifu",
  "version": "0.0.0",
  "private": true,
  "description": "Saifu — the holder app, and the only client holding holder credentials",
  "type": "module",
  "main": "index.ts",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "bundle:check": "expo export --platform ios --platform android --output-dir .expo/export-check",
    "deps:check": "expo install --check",
    "lint:copy": "node tools/copy-lint/cli.ts",
    "vendor:libticketto": "tools/vendor-libticketto.sh",
    "vendor:check": "tools/vendor-libticketto.sh --check",
    "well-known": "node tools/well-known/cli.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@virtonetwork/authenticators-webauthn": "1.2.7",
    "@virtonetwork/signer": "1.3.3",
    "expo": "57.0.22",
    "expo-constants": "57.0.18",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@noble/curves": "2.4.0",
    "@ticketto/profile-v0": "file:vendor/libticketto/ticketto-profile-v0-0.0.0.tgz",
    "@ticketto/sdk": "file:vendor/libticketto/ticketto-sdk-0.0.0.tgz",
    "@types/node": "24.13.4",
    "@types/react": "19.2.18",
    "oxc-parser": "0.149.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "@ticketto/profile-v0": "file:vendor/libticketto/ticketto-profile-v0-0.0.0.tgz",
      "@ticketto/sdk": "file:vendor/libticketto/ticketto-sdk-0.0.0.tgz"
    }
  }
}
