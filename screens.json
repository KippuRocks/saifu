{
  "format": "kippu.screens/1",
  "app": "saifu",
  "platform": "native",
  "screens": [
    {
      "screenId": "app.starting",
      "route": null,
      "title": "Starting",
      "navigatesTo": [
        "holder.onboarding",
        "tickets.list"
      ]
    },
    {
      "screenId": "holder.onboarding",
      "route": null,
      "title": "Set up Saifu",
      "navigatesTo": [
        "checkout.link",
        "invitation.redeem",
        "tickets.list"
      ]
    },
    {
      "screenId": "tickets.list",
      "route": null,
      "title": "Your tickets",
      "navigatesTo": [
        "settings.main",
        "ticket.detail",
        "tickets.receive"
      ]
    },
    {
      "screenId": "ticket.detail",
      "route": null,
      "title": "Ticket",
      "navigatesTo": [
        "ticket.pass",
        "tickets.list"
      ]
    },
    {
      "screenId": "tickets.receive",
      "route": null,
      "title": "Receive a ticket",
      "navigatesTo": [
        "tickets.list"
      ]
    },
    {
      "screenId": "ticket.pass",
      "route": null,
      "title": "Access pass",
      "navigatesTo": [
        "ticket.detail"
      ]
    },
    {
      "screenId": "settings.main",
      "route": null,
      "title": "Settings",
      "navigatesTo": [
        "tickets.list"
      ]
    },
    {
      "screenId": "checkout.link",
      "route": "/checkout#:handoffToken",
      "title": "Pair with your checkout",
      "navigatesTo": [
        "holder.onboarding",
        "tickets.list"
      ]
    },
    {
      "screenId": "invitation.redeem",
      "route": "/invitations#:token",
      "title": "Your invitation",
      "navigatesTo": [
        "holder.onboarding",
        "ticket.detail",
        "tickets.list"
      ]
    }
  ]
